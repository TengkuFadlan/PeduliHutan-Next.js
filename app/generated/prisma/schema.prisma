generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model esp_status {
  id          Int      @id @default(1)
  water_level Int
  last_taken  DateTime @db.DateTime()
  fire        Boolean  @default(false)
}

model history {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  fire      Boolean  @default(false)
}

model water_history {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  water_level Int      @default(0)
}

model user {
  id       Int    @id @default(autoincrement())
  username String
  email    String @unique
  password String
}
